{
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "runtime": "python311",
      "ignore": ["venv", ".venv", "__pycache__", "tests", "*.local"]
    }
  ],
  "firestore": { "rules": "firestore.rules", "indexes": "firestore.indexes.json" },
  "storage": { "rules": "storage.rules" },
  "hosting": {
    "public": ".",
    "ignore": ["firebase.json", "**/.*", "functions/**", "src/**", "docs/**", "worker/**", "native/**", "**/node_modules/**"]
  }
}
