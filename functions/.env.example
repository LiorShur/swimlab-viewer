# Environment for the swimlab Cloud Functions (Phase C).
# Copy to `.env` (git-ignored) — the Firebase CLI deploys it with the functions.
# The Anthropic key is NOT here; it's a secret (firebase functions:secrets:set).

# Freemium gate. false (default) = soft: any caller may narrate during testing.
# Set to true to enforce the paywall (free callers get PERMISSION_DENIED).
FREEMIUM_ENFORCED=false

# Comma-separated Firebase uids allowed to call set_tier (yourself, for testing).
# Find yours in Firebase console -> Authentication -> Users, or from the app.
ADMIN_UIDS=
