# Firebase web config for the native app (Vite env). Copy to `.env` (git-ignored)
# and paste from Firebase console -> Project Settings -> Your apps -> Web app.
# These values are NOT secret; they ship in the client. The Anthropic key stays
# a server secret behind the Cloud Functions.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
VITE_FIREBASE_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Optional: only if functions were deployed to a non-default region.
VITE_FIREBASE_REGION=us-central1
